# Local development — matches docker-compose.yml Postgres service
DATABASE_URL="postgresql://papeletto:papeletto@localhost:5432/papeletto?schema=public"

# Auth.js (NextAuth) — JWT session secret (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
# Optional public URL (useful in production)
# AUTH_URL="http://localhost:3000"

# Seed staff admin (dev only — change in production)
ADMIN_EMAIL="admin@papeletto.local"
ADMIN_PASSWORD="papeletto-admin"
ADMIN_NAME="Admin Papeletto"

PRINTNODE_API_KEY=""
PRINTNODE_DEFAULT_PRINTER_ID=""

N8N_WEBHOOK_CV_URL=""
N8N_WEBHOOK_DERECHO_PETICION_URL=""
N8N_WEBHOOK_SECRET=""

# Local file storage root (customer uploads / generated docs)
STORAGE_ROOT="./storage"
